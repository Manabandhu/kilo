# ============================================================================
# ManaBandhu - Environment Variables
# Copy this file to `.env` at the repository root and fill in real values.
# NEVER commit `.env`. Secrets below are placeholders only.
# ============================================================================

# ---- Supabase (hosted or local via `supabase start`) ----
# Public anon key (safe for frontend; RLS enforced on every table)
EXPO_PUBLIC_SUPABASE_URL=http://localhost:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=public-anon-key-placeholder
# JWT secret used by Spring Boot to validate Supabase-issued tokens.
# Get from `supabase status` / Supabase dashboard. NEVER expose to frontend.
SUPABASE_JWT_SECRET=replace-with-supabase-jwt-secret
# Service-role key: backend-only, used only for privileged admin operations.
# NEVER put this in the frontend or any client bundle.
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
SUPABASE_DB_URL=postgresql://postgres:postgres@localhost:54322/postgres
SUPABASE_STORAGE_BUCKET=manabandhu-media

# ---- Spring Boot backend ----
SPRING_PROFILES_ACTIVE=dev
BACKEND_PORT=8080
SUPABASE_URL=http://localhost:54321
# Backend database access (Flyway-managed schema runs through Spring Boot)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:54322/postgres
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres
# CORS allowlist (comma separated origins)
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:3000,exp://localhost:8081
# Push notification provider (abstraction; one of: console, firebase, apns, none)
PUSH_PROVIDER=console
# Rate limiting (requests per minute per identity)
RATE_LIMIT_PER_MINUTE=120
# Frontend web origin for deep links
APP_WEB_URL=http://localhost:8081

# ---- Map provider (abstraction) ----
MAP_PROVIDER=mapbox
MAPBOX_PUBLIC_TOKEN=replace-with-mapbox-public-token

# ---- Expo / EAS ----
EXPO_PUBLIC_APP_ENV=development
EAS_PROJECT_ID=replace-with-eas-project-id

# ---- Observability (integration points) ----
LOG_LEVEL=INFO
OTEL_EXPORTER_OTLP_ENDPOINT=
ERROR_REPORTING_DSN=
