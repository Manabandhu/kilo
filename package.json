{
  "name": "manabandhu",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.6.0",
  "scripts": {
    "dev": "turbo run dev",
    "dev:client": "pnpm --filter @manabandhu/client start",
    "dev:backend": "pnpm --filter @manabandhu/backend dev",
    "build": "turbo run build",
    "build:client": "pnpm --filter @manabandhu/client build:web",
    "build:backend": "pnpm --filter @manabandhu/backend build",
    "build:shared": "turbo run build --filter=@manabandhu/contracts --filter=@manabandhu/design-tokens --filter=@manabandhu/shared-config",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:ci": "turbo run test:ci",
    "test:unit": "turbo run test:unit",
    "test:integration": "turbo run test:integration",
    "db:start": "docker-compose up -d",
    "db:stop": "docker-compose down",
    "db:reset": "pnpm db:stop && pnpm db:start && sleep 5 && supabase db reset",
    "supabase:start": "supabase start",
    "supabase:reset": "supabase db reset",
    "supabase:migrate": "supabase db push",
    "supabase:pull": "supabase db pull",
    "db:studio": "supabase studio",
    "clean": "turbo run clean && rm -rf node_modules .turbo",
    "prepare": "pnpm install"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "turbo": "^2.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}