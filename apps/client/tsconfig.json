{
  "extends": "../packages/shared-config/tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@manabandhu/contracts": ["../../packages/contracts/src/index.ts"],
      "@manabandhu/design-tokens": ["../../packages/design-tokens/src/index.ts"]
    },
    "jsx": "react-jsx",
    "noEmit": true,
    "incremental": true,
    "isolatedModules": true,
    "moduleResolution": "Bundler",
    "resolveJsonModule": true
  },
  "include": ["**/*", "expo-env.d.ts"],
  "exclude": ["node_modules", "dist", "web-build"]
}
