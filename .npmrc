# pnpm configuration
auto-install-peers=true
hoist-pattern:
  - "@expo/*"
  - "expo"
  - "react-native"
  - "react"
  - "@react-navigation/*"
  - "react-navigation"
  - "react-native-*"
  - "@react-native/*"
  - "metro*"
  - "expo-*"
  - "@expo/*"

# Workspace settings
link-workspace-packages: true
prefer-workspace-packages: true

# Performance
network-concurrency: 8
child-concurrency: 4

# Store
store-dir: ~/.pnpm-store

# Audit
audit-level: high